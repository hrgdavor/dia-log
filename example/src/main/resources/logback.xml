<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!--
        Standard Logback ConsoleAppender with CustomJsonEncoder.
        Produces structured JSON output — keeps {name} placeholders literal in msg
        and stores values in kv for downstream tools to reconstruct.
    -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="hr.hrg.dialog.logback.CustomJsonEncoder">
            <includeMDC>true</includeMDC>
            <includeKeys>true</includeKeys>
            <includeSource>false</includeSource>
            <prettyPrint>false</prettyPrint>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="JSON" />
    </root>

</configuration>