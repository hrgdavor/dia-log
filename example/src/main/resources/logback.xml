<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!--
        JSON rolling file appender using JsonAppenderRolling + JsonLogWriter.
        Emits flat JSON fields: ts, level, logger, thread, msg, key/value pairs,
        and (for exceptions) errClass, errMessage, stack, errHash.
    -->
    <appender name="JSON_FILE" class="hr.hrg.dialog.logback.JsonAppenderRolling">
        <file>logs/example.jsonl</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!--
                Logback 1.5.18+ has native XZ compression support: when the
                fileNamePattern ends with .xz, rotated files are compressed with
                the org.tukaani:xz library using XZCompressionStrategy.
            -->
            <fileNamePattern>logs/example.%d{yyyy-MM-dd}.%i.jsonl.xz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <!--
            JsonAppenderRolling overrides writeOut() to emit JSON directly, so the
            encoder below is only required to satisfy OutputStreamAppender.start().
        -->
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="JSON_FILE" />
    </root>

</configuration>